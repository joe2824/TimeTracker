{
  "name": "timetracker",
  "version": "0.9.0-beta.16",
  "description": "",
  "type": "module",
  "scripts": {
    "prepare": "node scripts/prepare-sync.mjs && svelte-kit sync",
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/prepare-sync.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "node scripts/prepare-sync.mjs && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "server:dev": "npm --workspace server run dev",
    "server:build": "npm run pwa:bundle && npm --workspace server run build",
    "server:test": "npm --workspace server run test",
    "build:web": "cross-env BUILD_TARGET=web vite build",
    "dev:web": "cross-env BUILD_TARGET=web vite dev",
    "pwa:bundle": "npm run build:web && node scripts/copy-pwa.mjs",
    "server:check": "npm --workspace server run check"
  },
  "license": "MIT",
  "dependencies": {
    "@scure/bip39": "^2.3.0",
    "@simplewebauthn/browser": "^13.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-deep-link": "^2.4.9",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.28.0",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/vite": "^4.3.1",
    "@tauri-apps/cli": "^2",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^26.1.2",
    "cross-env": "^10.1.0",
    "d3-scale": "^4.0.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.11.6",
    "layerchart": "^2.0.0-next.48",
    "mode-watcher": "^1.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "svelte-sonner": "^1.1.1",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "workspaces": [
    "server"
  ],
  "allowScripts": {
    "better-sqlite3@12.11.1": true,
    "fsevents@2.3.3": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true
  }
}
