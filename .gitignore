.DS_Store
node_modules
/build
/.svelte-kit
/package
.env
.env.*
!.env.example
vite.config.js.timestamp-*
vite.config.ts.timestamp-*

# Echte Zeitwirtschaftsreports aus LOGA/Scout: enthalten Personalnummer und
# Klarnamen. Bewusst ohne Anker und breit gefasst – eine umbenannte oder in einen
# Unterordner gelegte Kopie traegt dieselben Daten. Fuer Tests liegt eine
# anonymisierte Fassung unter src/lib/testing/ (Ausnahme unten).
*.xlsx
!src/lib/testing/*.fixture.xlsx

# Der Web-Bau der PWA (Ausgabe, gehoert nicht ins Verzeichnis)
/build-web

# Server
server/build/
server/.svelte-kit/
server/data/
server/.env
server/*.db
server/*.db-shm
server/*.db-wal
server/static/

# Arbeitskopie der Wiki-Seiten (eigenes Repo, siehe scripts/wiki-push.sh)
wiki/

# Server-Datenbank aus Testlaeufen im Repo-Wurzelverzeichnis
# (vitest --root server, von hier aus gestartet)
/data/

# Lokale Einstellungen der KI-Werkzeuge (maschinenspezifisch, nicht geteilt).
# Die geteilten Anweisungen stehen in AGENTS.md, CLAUDE.md bindet sie ein.
.claude/settings.local.json
.claude/*.local.json
