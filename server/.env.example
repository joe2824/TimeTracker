# Vorlage fuer die .env neben der docker-compose.yml.
#
# Kopieren, ausfuellen, und NICHT einchecken.

# Die Adresse, unter der die Anwendung im Browser erreichbar ist.
# Muss exakt stimmen, inklusive Schema - WebAuthn prueft sie.
ORIGIN=https://tracker.example.de

# Der Hostname ohne Schema und Port.
#
# ACHTUNG, die wichtigste Zeile hier: Passkeys sind fest an diesen Wert
# gebunden. Wird der Dienst spaeter auf eine andere Domain umgezogen, sind ALLE
# registrierten Passkeys wertlos und jeder muss sich ueber die
# Wiederherstellungs-Phrase neu einrichten.
#
# Deshalb von Anfang an die endgueltige Domain eintragen - auch solange der
# Container nur im Heimnetz erreichbar ist. Per Split-DNS auf die interne
# Adresse zeigen und ein Zertifikat ueber die DNS-Challenge ausstellen.
RP_ID=tracker.example.de

# Der Name, den der Anmeldedialog des Betriebssystems anzeigt.
RP_NAME=TimeTracker

# Herkuenfte fuer schreibende Anfragen, durch Komma getrennt.
# Leer lassen heisst: nur ORIGIN.
ALLOWED_ORIGINS=https://tracker.example.de

# Einladungscodes aus der Umgebung, durch Komma getrennt.
#
# Das ist eine TUERKLINKE, kein Ticket: mehrfach benutzbar, ohne Frist, ohne
# Spur. Sie ist fuer den allerersten Menschen gedacht - ohne ihn gaebe es
# niemanden, der Einladungen ausstellen koennte.
#
# Sobald jemand Verwalter ist (siehe unten), sollte diese Zeile leer werden.
# Ab dann wird jede Einladung einzeln vergeben, gilt genau einmal und ist
# nachvollziehbar.
INVITE_CODES=bitte-hier-etwas-langes-und-zufaelliges

# Darf sich JEDER registrieren, der die Adresse kennt?
#
# Voreinstellung ist nein. Eine leere INVITE_CODES-Zeile oeffnet den Dienst
# NICHT - das ist Absicht: sonst waere der sorgfaeltigere Schritt (Tuerklinke
# weg, Einladungen einzeln vergeben) ausgerechnet der, der die Tuer aufmacht.
#
# Auf "true" zu stellen bringt Betreiberpflichten mit sich: Impressum,
# Datenschutzerklaerung, Loeschkonzept.
REGISTRATION_OPEN=false

# ---------------------------------------------------------------------------
# Den ersten Verwalter ernennen
#
#   1. Container starten, im Browser mit einem Code aus INVITE_CODES anmelden
#   2. docker compose exec timetracker node admin.mjs liste
#   3. docker compose exec timetracker node admin.mjs ernenne "<Name oder Kennung>"
#   4. INVITE_CODES hier leeren und neu starten
#
# Danach vergibt der Verwalter Einladungen ueber die Oberflaeche.
