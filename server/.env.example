# Vorlage fuer die .env neben der docker-compose.yml.
#
# Kopieren, ausfuellen, und NICHT einchecken.

# Die Adresse, unter der die Anwendung im Browser erreichbar ist.
# Muss exakt stimmen, inklusive Schema - WebAuthn prueft sie.
ORIGIN=https://tracker.example.de

# Der Hostname ohne Schema und Port.
#
# ACHTUNG, die wichtigste Zeile hier: Passkeys sind fest an diesen Wert
# gebunden. Wird der Dienst spaeter auf eine andere Domain umgezogen, sind ALLE
# registrierten Passkeys wertlos und jeder muss sich ueber die
# Wiederherstellungs-Phrase neu einrichten.
#
# Deshalb von Anfang an die endgueltige Domain eintragen - auch solange der
# Container nur im Heimnetz erreichbar ist. Per Split-DNS auf die interne
# Adresse zeigen und ein Zertifikat ueber die DNS-Challenge ausstellen.
RP_ID=tracker.example.de

# Der Name, den der Anmeldedialog des Betriebssystems anzeigt.
RP_NAME=TimeTracker

# Herkuenfte fuer schreibende Anfragen, durch Komma getrennt.
# Leer lassen heisst: nur ORIGIN.
ALLOWED_ORIGINS=https://tracker.example.de

# Einladungscodes, durch Komma getrennt.
#
# Solange hier etwas steht, ist die Registrierung geschlossen - so faengt der
# Dienst an. Eine LEERE Zeile oeffnet ihn fuer jeden, der die Adresse kennt;
# das ist eine bewusste Entscheidung und bringt Betreiberpflichten mit sich
# (Impressum, Datenschutzerklaerung, Loeschkonzept).
INVITE_CODES=bitte-hier-etwas-langes-und-zufaelliges
