# Vorlage fuer src-tauri/.env – die echte Datei ist bewusst nicht im Repo.
#
# Nur noetig, wenn ein Bau von Hand ebenfalls Nutzungszahlen senden soll. Im
# Release baut der Workflow den Key aus der GitHub-Variablen APTABASE_KEY ein
# (.github/workflows/release.yml); ohne Key laeuft alles unveraendert, es geht
# nur nichts raus.
#
# Alternativ ohne Datei:  APTABASE_KEY=A-EU-... npm run tauri build
APTABASE_KEY=
